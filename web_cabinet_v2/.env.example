# XFI_CONNECT native database
XFI_CONNECT_DB_PATH=/opt/XFI_CONNECT/database/vpn_bot.db
XFI_CONNECT_SERVER_ID=

# Web cabinet
SECRET_KEY=replace-with-a-long-random-secret
WEB_DB_PATH=/opt/XFI_CONNECT/web_cabinet_v2/data/web_cabinet.db
SESSION_COOKIE_SECURE=true
AUTH_CODE_TTL=600

# 3X-UI API
XUI_BASE_URL=https://127.0.0.1:2053
XUI_API_TOKEN=
XUI_INBOUND_ID=
XUI_SUB_BASE_URL=https://example.com/sub
XUI_TIMEOUT=20
XUI_VERIFY_TLS=true

# Telegram bridge
TELEGRAM_BOT_USERNAME=XFI_VPN_bot
XFI_WEB_SECRET=replace-with-another-random-secret

# Trial
TRIAL_DAYS=3
TRIAL_TRAFFIC_GB=0

# Platega
PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_RETURN_URL=https://example.com/cabinet
